{
  "name": "@quarryserp/client",
  "version": "0.1.2",
  "description": "Official TypeScript client for the Quarry Google search results API.",
  "keywords": [
    "quarry",
    "google",
    "search",
    "serp",
    "api",
    "client",
    "typescript"
  ],
  "homepage": "https://quarryserp.com/docs/typescript",
  "bugs": {
    "email": "support@quarryserp.com"
  },
  "license": "MIT",
  "author": "Quarry <support@quarryserp.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "bun": "./src/types.ts",
      "import": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/types.ts --outdir dist --target node --format esm && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarryserp/quarry-js.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
